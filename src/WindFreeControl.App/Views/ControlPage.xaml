<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WindFreeControl.App.Views.ControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:WindFreeControl.Core.Localization"
    xmlns:look="using:WindFreeControl.App.Look"
    xmlns:views="using:WindFreeControl.App.Views"
    Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Padding="16,0,16,0" Spacing="8">
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                Severity="Warning" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsStale, Mode=OneWay}"
                Message="{x:Bind ViewModel.StaleText, Mode=OneWay}"
                Severity="Informational" />
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="ContentPanel" Padding="16,4,16,16" Spacing="12">
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing
                                        Width="14"
                                        Height="14"
                                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.PowerText, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Width="56"
                                Height="56"
                                Padding="0"
                                AutomationProperties.Name="{x:Bind loc:Strings.Control_Power}"
                                Background="{x:Bind look:ModeAccent.Brush(ViewModel.AccentKey), Mode=OneWay}"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.TogglePowerCommand}"
                                CornerRadius="28"
                                Foreground="White"
                                ToolTipService.ToolTip="{x:Bind loc:Strings.Control_Power}">
                                <FontIcon FontSize="22" Glyph="{x:Bind look:Glyphs.Power}" />
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" HorizontalAlignment="Center" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind loc:Strings.Control_Decrease}"
                                Command="{x:Bind ViewModel.DecreaseTargetCommand}"
                                IsEnabled="{x:Bind ViewModel.CanDecreaseTarget, Mode=OneWay}"
                                Style="{StaticResource RoundButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind loc:Strings.Control_Decrease}">
                                <FontIcon FontSize="16" Glyph="&#xE738;" />
                            </Button>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="76"
                                    FontWeight="Light"
                                    Foreground="{x:Bind look:ModeAccent.Brush(ViewModel.AccentKey), Mode=OneWay}"
                                    Text="{x:Bind ViewModel.TargetText, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind loc:Strings.Control_Target}" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind loc:Strings.Control_Increase}"
                                Command="{x:Bind ViewModel.IncreaseTargetCommand}"
                                IsEnabled="{x:Bind ViewModel.CanIncreaseTarget, Mode=OneWay}"
                                Style="{StaticResource RoundButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind loc:Strings.Control_Increase}">
                                <FontIcon FontSize="16" Glyph="&#xE710;" />
                            </Button>
                        </Grid>
                        <StackPanel
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="{x:Bind look:Glyphs.Thermometer}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.RoomText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="{x:Bind look:Glyphs.Drop}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.HumidityText, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <views:OptionGroupView Group="{x:Bind ViewModel.Mode}" />
                <views:OptionGroupView Group="{x:Bind ViewModel.FanMode}" />
                <views:OptionGroupView Group="{x:Bind ViewModel.WindDirection}" />
                <views:OptionGroupView Group="{x:Bind ViewModel.OptionalMode}" />
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasEnergy, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE945;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind loc:Strings.Energy_Title}" />
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind loc:Strings.Energy_Now}" />
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.PowerNowText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind loc:Strings.Energy_Total}" />
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.EnergyTotalText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE9E9;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind loc:Strings.Options_Title}" />
                        </StackPanel>
                        <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasTropicalNight, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xF1DB;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind loc:Strings.TropicalNight_Title}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.TropicalNightText, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                            <NumberBox
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind loc:Strings.TropicalNight_Title}"
                                IsEnabled="{x:Bind ViewModel.IsOn, Mode=OneWay}"
                                Maximum="35"
                                Minimum="0"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.TropicalNightHours, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasSound, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE767;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind loc:Strings.Sound_Title}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind loc:Strings.Sound_Description}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="2"
                                MinWidth="0"
                                AutomationProperties.Name="{x:Bind loc:Strings.Sound_Title}"
                                IsOn="{x:Bind ViewModel.SoundOn, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                        <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasLight, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xEA80;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind loc:Strings.Light_Title}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind loc:Strings.Light_Description}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="2"
                                MinWidth="0"
                                AutomationProperties.Name="{x:Bind loc:Strings.Light_Title}"
                                IsOn="{x:Bind ViewModel.LightOn, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                        <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasAutoClean, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xEA99;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind loc:Strings.AutoClean_Title}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.AutoCleanText, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="2"
                                MinWidth="0"
                                AutomationProperties.Name="{x:Bind loc:Strings.AutoClean_Title}"
                                IsOn="{x:Bind ViewModel.AutoCleanOn, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE90F;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind loc:Strings.Maintenance_Title}" />
                        </StackPanel>
                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasFilter, Mode=OneWay}">
                        <Grid ColumnSpacing="12" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE71C;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind loc:Strings.Filter_Title}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.FilterText, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" VerticalAlignment="Center" Click="OnResetFilterClick" Content="{x:Bind loc:Strings.Filter_Reset}" />
                        </Grid>
                            <ProgressBar Maximum="100" ShowError="{x:Bind ViewModel.FilterNeedsAttention, Mode=OneWay}" Value="{x:Bind ViewModel.FilterUsage, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.FilterStatusText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.FilterNeedsAttention, Mode=OneWay}" />
                        </StackPanel>
                        <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasSelfCheck, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" Glyph="&#xE9D9;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind loc:Strings.SelfCheck_Title}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.SelfCheckText, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                <Button Command="{x:Bind ViewModel.StartSelfCheckCommand}" Content="{x:Bind loc:Strings.SelfCheck_Start}" Visibility="{x:Bind look:Show.Unless(ViewModel.IsSelfChecking), Mode=OneWay}" />
                                <Button Command="{x:Bind ViewModel.CancelSelfCheckCommand}" Content="{x:Bind loc:Strings.SelfCheck_Cancel}" Visibility="{x:Bind ViewModel.IsSelfChecking, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="{x:Bind loc:Strings.DeviceInfo_Title}">
                            <Grid ColumnSpacing="12" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind loc:Strings.DeviceInfo_Firmware}" />
                                <TextBlock Grid.Column="1" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.FirmwareText, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind loc:Strings.DeviceInfo_Module}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.ModuleText, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind loc:Strings.DeviceInfo_Year}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.YearText, Mode=OneWay}" />
                            </Grid>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
