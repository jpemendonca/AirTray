<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WindFreeControl.App.Views.FlyoutPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:WindFreeControl.Core.Localization"
    xmlns:look="using:WindFreeControl.App.Look">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Padding="16,16,16,12" Spacing="14">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.PowerText, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.RoomText, Mode=OneWay}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Width="44"
                    Height="44"
                    Padding="0"
                    AutomationProperties.Name="{x:Bind loc:Strings.Control_Power}"
                    Background="{x:Bind look:ModeAccent.Brush(ViewModel.AccentKey), Mode=OneWay}"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.TogglePowerCommand}"
                    CornerRadius="22"
                    Foreground="White"
                    ToolTipService.ToolTip="{x:Bind loc:Strings.Control_Power}">
                    <FontIcon FontSize="18" Glyph="{x:Bind look:Glyphs.Power}" />
                </Button>
            </Grid>
            <Grid HorizontalAlignment="Center" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind loc:Strings.Control_Decrease}"
                    Command="{x:Bind ViewModel.DecreaseTargetCommand}"
                    IsEnabled="{x:Bind ViewModel.CanDecreaseTarget, Mode=OneWay}"
                    Style="{StaticResource RoundButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE738;" />
                </Button>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Variable Display"
                    FontSize="48"
                    FontWeight="Light"
                    Foreground="{x:Bind look:ModeAccent.Brush(ViewModel.AccentKey), Mode=OneWay}"
                    Text="{x:Bind ViewModel.TargetText, Mode=OneWay}" />
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind loc:Strings.Control_Increase}"
                    Command="{x:Bind ViewModel.IncreaseTargetCommand}"
                    IsEnabled="{x:Bind ViewModel.CanIncreaseTarget, Mode=OneWay}"
                    Style="{StaticResource RoundButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE710;" />
                </Button>
            </Grid>
            <Grid x:Name="Shortcuts" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>
        </StackPanel>
        <Grid
            Grid.Row="1"
            Padding="12,8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <HyperlinkButton x:Name="OpenButton" Content="{x:Bind loc:Strings.Flyout_Open}" />
            <Button
                x:Name="SettingsButton"
                Grid.Column="1"
                Width="36"
                Height="32"
                Padding="0"
                AutomationProperties.Name="{x:Bind loc:Strings.Settings_Open}"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="{x:Bind loc:Strings.Settings_Open}">
                <FontIcon FontSize="14" Glyph="{x:Bind look:Glyphs.Settings}" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
