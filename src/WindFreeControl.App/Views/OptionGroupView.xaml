<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WindFreeControl.App.Views.OptionGroupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="8" Visibility="{x:Bind Group.HasItems, Mode=OneWay}">
        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Group.Title}" />
        <VariableSizedWrapGrid
            x:Name="Tiles"
            ItemHeight="44"
            ItemWidth="128"
            Orientation="Horizontal" />
    </StackPanel>
</UserControl>
