<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WindFreeControl.App.Views.OptionGroupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WindFreeControl.Core.ViewModels">
    <StackPanel Spacing="8" Visibility="{x:Bind Group.HasItems, Mode=OneWay}">
        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Group.Title}" />
        <GridView
            IsEnabled="{x:Bind Group.IsEnabled, Mode=OneWay}"
            ItemsSource="{x:Bind Group.Items}"
            SelectedIndex="{x:Bind Group.SelectedIndex, Mode=TwoWay}"
            SelectionMode="Single">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:OptionItem">
                    <TextBlock
                        Margin="12,6"
                        Opacity="{x:Bind vm:OptionGroupLook.Opacity(IsAvailable)}"
                        Text="{x:Bind Label}" />
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </StackPanel>
</UserControl>
